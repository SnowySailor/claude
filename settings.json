{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "5m",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 350000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 350000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 350000
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "theme": "auto",
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
}
